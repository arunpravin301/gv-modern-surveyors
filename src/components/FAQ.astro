---
const faqs = [
  {
    question: "What is a topographical survey?",
    answer: "A topographical survey maps the physical features of a property, including boundaries, elevations, trees, and existing structures. It is essential for architects, engineers, and builders before starting any construction project."
  },
  {
    question: "How much does a land survey cost in India?",
    answer: "The cost of a land survey depends on the size of the property, the complexity of the terrain, and the type of survey required (e.g., FMB verification vs. DGPS). Contact us with your property details for a precise, customized quote."
  },
  {
    question: "What is an FMB sketch?",
    answer: "An FMB (Field Measurement Book) sketch is a government record that outlines the exact dimensions and boundaries of a specific land parcel. We provide precise FMB drawing works to resolve boundary disputes and ensure legal compliance."
  },
  {
    question: "How long does a typical land survey take?",
    answer: "Most residential and small commercial surveys can be completed in 1 to 2 days of field operations, followed by 1 to 3 days for data processing and drawing delivery. Large-scale projects may take longer."
  },
  {
    question: "Why use DGPS surveying over traditional methods?",
    answer: "Differential Global Positioning System (DGPS) surveying offers millimeter-level accuracy over vast distances in a fraction of the time. It is highly precise, reducing human error and providing reliable data for critical infrastructure projects."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="faq-section" style="padding: 130px 0; background: var(--c-bg); border-top: 1px solid var(--c-border); position: relative;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 4vw;">
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8vw;">
      
      <!-- Left side: Header -->
      <div class="faq-header" data-gsap="fade-up">
        <div class="mono" style="color: var(--c-gold); margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
          / 05 KNOWLEDGE BASE
          <span style="display: block; width: 80px; height: 1px; background: var(--c-border);"></span>
        </div>
        <h2 style="font-family: var(--f-disp); font-size: clamp(32px, 4vw, 56px); color: var(--c-paper); line-height: 1.1; margin-bottom: 24px; font-weight: 700;">
          Frequently Asked <br/><span style="color: var(--c-t3);">Questions.</span>
        </h2>
        <p style="color: var(--c-t2); font-size: 17px; max-width: 40ch; line-height: 1.6;">
          Clear, concise answers to the most common queries about our field surveying operations, timelines, and technical processes.
        </p>
      </div>

      <!-- Right side: Accordion -->
      <div class="faq-grid">
        {faqs.map((faq, index) => (
          <details class="faq-item" data-gsap="fade-up">
            <summary class="faq-question">
              <h3 style="font-family: var(--f-disp); font-size: 20px; font-weight: 600; color: var(--c-paper); margin: 0;">{faq.question}</h3>
              <span class="faq-icon" style="color: var(--c-gold); font-family: var(--f-mono); font-size: 24px; line-height: 1; font-weight: normal;">+</span>
            </summary>
            <div class="faq-answer">
              <p style="color: var(--c-t2); font-size: 16px; line-height: 1.6; margin: 0;">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
  
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .faq-item {
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    transition: border-color 0.3s ease;
  }
  
  .faq-item:hover {
    border-color: rgba(224, 165, 38, 0.3); /* faint gold */
  }
  
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 32px;
    cursor: pointer;
    list-style: none; /* Hide default arrow */
  }
  
  .faq-question::-webkit-details-marker {
    display: none; /* Hide default arrow in Safari */
  }
  
  .faq-icon {
    transition: transform 0.3s ease;
  }
  
  details[open] .faq-item {
    border-color: var(--c-gold);
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--c-paper) !important;
  }
  
  .faq-answer {
    padding: 0 32px 32px 32px;
    animation: slideDown 0.3s ease-out forwards;
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-gsap="fade-up"] {
    opacity: 0;
    transform: translateY(30px);
  }

  @media(max-width: 900px) {
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    .faq-question {
      padding: 20px 24px;
    }
    .faq-answer {
      padding: 0 24px 24px 24px;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (typeof window !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);
    
    const fadeEls = gsap.utils.toArray('[data-gsap="fade-up"]');
    fadeEls.forEach((el: any) => {
      gsap.to(el, {
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out"
      });
    });
  }
</script>
